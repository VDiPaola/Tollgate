# =============================================================================
# Google Play
# =============================================================================

# The app's applicationId, which must match the Play Console entry exactly.
GOOGLE_PLAY_PACKAGE_NAME=com.example.app

# The service account's JSON key, base64-encoded.
#
# Base64 rather than raw JSON because the private key inside contains newlines,
# and a newline in a .env value is either a parse error or a silently truncated
# key depending on what reads the file.
#
#   base64 -w0 service-account.json
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("$PWD\service-account.json"))
#
# Carries the client email, the private key and the project id, so nothing else
# has to be kept in step with it.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# --- Real-time developer notifications ---------------------------------------
#
# The notification endpoint is public, so the Google-signed token on each push
# request is the only thing separating a real delivery from any other POST that
# reaches it. These are what that check compares against.

# The audience configured on the Pub/Sub push subscription, normally the
# endpoint's own URL. This is what makes a token minted for another service
# useless here.
GOOGLE_PUBSUB_AUDIENCE=

# The service account Pub/Sub signs its push requests as. This is the one
# nominated when creating the push subscription, not Google Play's own
# publisher account.
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# The topic Play publishes to, as projects/<project-id>/topics/<topic>.
#
# Recorded for reference; not read at runtime. A Pub/Sub push names the
# subscription, not the topic, so there is nothing to compare it against. What
# actually guards against a subscription wired to the wrong app is the
# packageName carried by every developer notification, which is checked against
# GOOGLE_PLAY_PACKAGE_NAME.
GOOGLE_RTDN_TOPIC=

# --- Development conveniences ------------------------------------------------
#
# A Play purchase needs a person tapping through the Play dialog on a physical
# device, so a real token has to be carried in by hand to check the server side
# against it. Not read at runtime.
GOOGLE_TEST_PURCHASE_TOKEN=
GOOGLE_TEST_PRODUCT_ID=
GOOGLE_TEST_BASE_PLAN_ID=

# =============================================================================
# Which environment this deployment is
# =============================================================================

# Whether a store's TEST purchases may grant real entitlements here.
#
# `sandbox` on a development stack, and unset everywhere else: anything that is
# not exactly `sandbox` is production. This is the most security-relevant
# setting there is, because Google has no test environment at all and a licence
# tester's purchase arrives through the same API as a real sale, marked by a
# field. A production deployment that accepts those is a free subscription for
# anyone who can reach a test account.
#
# It is an environment variable rather than a row in tollgate.config on purpose.
# A row travels with the migration that creates it and then has to be remembered
# and changed by hand on every stack, which is how a development value reaches
# production.
TOLLGATE_ENVIRONMENT=sandbox

# =============================================================================
# Supabase: the stack Tollgate writes to
# =============================================================================

# Point these at a development stack, matching TOLLGATE_ENVIRONMENT above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Stripe
# =============================================================================

# Stripe does have a real separate environment, so an sk_test_ key here cannot
# reach live data.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Apple App Store
# =============================================================================
#
# See docs/apple-setup.md for where each of these comes from.

# The app's bundle id, which must match the key's app exactly. Apple refuses an
# API token whose bundle id is not the one its key was issued for.
APPLE_BUNDLE_ID=com.example.app

# From App Store Connect, Users and Access, Integrations, In-App Purchase. One
# issuer id for the whole account; one key id per key.
APPLE_ISSUER_ID=
APPLE_KEY_ID=

# The .p8 file's contents, base64-encoded. Base64 for the same reason as the
# Google key: the PEM contains newlines and a newline in a .env value is either
# a parse error or a silently truncated key.
#
#   base64 -w0 AuthKey_ABCD123456.p8
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("$PWD\AuthKey_ABCD123456.p8"))
#
# Apple shows the file once. There is no way to download it again.
APPLE_PRIVATE_KEY_BASE64=

# Which App Store Server API to ask first. Only an optimisation: sandbox and
# production are separate hosts holding separate transactions, and a lookup that
# misses is retried against the other one either way. Whether a sandbox purchase
# then grants anything is decided by TOLLGATE_ENVIRONMENT, not by this.
APPLE_ENVIRONMENT=sandbox
